{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口可调用的命令，以及接收任务事件所需的监听权限",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-engine-capabilities",
    "allow-job-start-read-scan",
    "allow-job-cancel",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
