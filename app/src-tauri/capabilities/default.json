    "allow-app-info",
    "allow-engine-capabilities",
    "allow-disk-list",
    "allow-carve-file-types",
    "allow-job-start-read-scan",
    "allow-job-start-carve",
    "allow-job-resume-carve",
    "allow-carve-history-list",
    "allow-carve-history-open",
    "allow-carve-history-remove",
    "allow-job-cancel",
    "allow-job-set-paused",
    "allow-recovered-preview",
    "allow-recovered-open",
    "allow-recovered-open-with",
    "allow-recovered-copy",
    "allow-recovered-reveal",
    "allow-carve-preview-range",
    "allow-job-start-extract",
    "allow-browse-open",
    "allow-browse-list",
    "allow-browse-preview",
    "allow-browse-scan",
    "allow-browse-cancel-scan",
    "allow-job-start-partition-search",
    "allow-browse-open-range",
    "allow-job-start-copy",
    "allow-copied-open",
    "allow-copied-reveal",
    "allow-job-start-image",
    "allow-image-inspect",
    "allow-image-history-list",
