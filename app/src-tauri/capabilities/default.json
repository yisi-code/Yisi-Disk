    "allow-image-history-relocate",
    "allow-image-reveal",
    "allow-boot-diagnose",
    "allow-write-plan-boot-sector",
    "allow-write-plan-partition-table",
    "allow-write-plan-mft",
    "allow-write-plan-fs-fix",
    "allow-fs-rate-fat-copies",
    "allow-job-start-save-lost",
    "allow-job-start-scan-free",
    "allow-write-plan-execute",
    "allow-write-plan-discard",
    "allow-write-plan-rollback",
    "allow-write-history-list",
    "allow-job-start-fs-check",
    "allow-fs-check-save-report",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
